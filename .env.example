# Copia este fichero a .env y ajusta los valores.

# --- Base de datos ---
# Evita caracteres especiales en la contraseña (se usa dentro de una URL).
POSTGRES_USER=hellopadel
POSTGRES_PASSWORD=hellopadel
POSTGRES_DB=hellopadel
# Puerto expuesto en tu máquina (5433 para no chocar con otro Postgres local).
DB_PORT=5433

# --- Backend ---
ENVIRONMENT=development
BACKEND_PORT=8000
# Genera uno con: openssl rand -hex 32  (obligatorio en producción)
JWT_SECRET=dev-insecure-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# true cuando se sirva por HTTPS
COOKIE_SECURE=false
# Orígenes permitidos separados por comas. Vacío = sin CORS (el frontend usa el proxy de Vite).
CORS_ORIGINS=

# --- Tiempo (Open-Meteo) ---
WEATHER_CACHE_TTL_SECONDS=900
WEATHER_DEFAULT_NAME=Barcelona
WEATHER_DEFAULT_LATITUDE=41.3874
WEATHER_DEFAULT_LONGITUDE=2.1686

# --- Frontend ---
FRONTEND_PORT=5173
